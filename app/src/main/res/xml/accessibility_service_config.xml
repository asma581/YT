<?xml version="1.0" encoding="utf-8"?>
<!--
    Configuration for BlockerAccessibilityService.
    - We only need "window changed" events (which app is on screen) and
      "content changed" events (so we notice when a browser navigates to youtube.com).
    - canRetrieveWindowContent + flagReportViewIds let us read a browser's address bar.
    - The service narrows the packages it listens to in onServiceConnected().
-->
<accessibility-service xmlns:android="http://schemas.android.com/apk/res/android"
    android:accessibilityEventTypes="typeWindowStateChanged|typeWindowContentChanged"
    android:accessibilityFeedbackType="feedbackGeneric"
    android:accessibilityFlags="flagReportViewIds"
    android:canRetrieveWindowContent="true"
    android:description="@string/accessibility_service_description"
    android:notificationTimeout="300" />
